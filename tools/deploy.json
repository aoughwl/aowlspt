{
  "//": "Data for `python tools/deploy.py`. Each artifact names where it is built,",
  "//1": "where it goes in a live install, and the literal strings that MUST be",
  "//2": "present in the built file. A marker is a feature's fingerprint: if the",
  "//3": "string is gone, the feature is gone, and the deploy is refused.",
  "//4": "Markers must be literals the compiler cannot fold away -- log message",
  "//5": "text is ideal, because it is emitted verbatim and it names the feature.",
  "//6": "Add a marker the same day you add a feature; that is the whole point.",
  "install": "D:\\Aowlspt\\aowlspt",
  "artifacts": [
    {
      "name": "host",
      "src": "host/Aowlspt.Host.Il2Cpp/bin/aowlspt-host-il2cpp.dll",
      "dst": "aowlspt-host-il2cpp.dll",
      "minBytes": 500000,
      "markers": [
        "aowlspt-host-il2cpp",
        "host running",
        "IL2CPP runtime bound, all essential entry points present",
        "overlay ready (F12 opens settings)",
        "botcap (offline bot-cap lift)",
        "botdiag",
        "botai",
        "debugui: PreloaderUI::Update detour is live",
        "debugEsp",
        "menu mode text:",
        "settings pages: persisted",
        "settingsRelabelProbe",
        "settingsBindProbe",
        "osCloseFix",
        "imageCdnRedirect",
        "uxVersionBrand",
        "unlimitedBots",
        "invoke2",
        "anti-cheat:",
        "mods tab: built"
      ]
    },
    {
      "name": "tarkov",
      "src": "mods/tarkov/bin/tarkov.dll",
      "dst": "mods/tarkov/tarkov.dll",
      "minBytes": 100000,
      "markers": [
        "aowl.tarkov",
        "/client/game/start",
        "/client/game/profile/list",
        "/client/items",
        "/client/locations",
        "BotLocationModifier"
      ]
    },
    {
      "name": "backend",
      "src": "backend/bin/aowlspt-backend.exe",
      "dst": "aowlspt-backend.exe",
      "minBytes": 100000,
      "markers": [
        "aowlspt-backend",
        "listening on"
      ]
    },
    {
      "name": "launch",
      "src": "installer/build/aowlspt-launch.exe",
      "dst": "aowlspt-launch.exe",
      "minBytes": 100000,
      "markers": [
        "aowlspt-launch",
        "host running",
        "backendUrl"
      ]
    }
  ]
}
