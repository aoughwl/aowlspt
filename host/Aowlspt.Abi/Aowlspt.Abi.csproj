<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      netstandard2.1 on purpose: the BepInEx client host runs on Unity's Mono
      and the server host on .NET 10, and this assembly is referenced by both.
      Anything that cannot be expressed here (UnmanagedCallersOnly, NativeLibrary)
      belongs in the side-specific host, not in the shared contract.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Aowlspt.Abi</AssemblyName>
    <RootNamespace>Aowlspt.Abi</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
