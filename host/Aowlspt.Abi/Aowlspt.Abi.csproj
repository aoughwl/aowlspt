<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net10.0 since the pre-1.0 hosts were retired. This targeted netstandard2.1
      so the BepInEx client host (Unity Mono) and the SPT server host (.NET 10)
      could share it. Both are gone (post-1.0 Tarkov is IL2CPP and its host is
      native nimony), and aowlspt-sim, the only consumer left, is .NET 10.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aowlspt.Abi</AssemblyName>
    <RootNamespace>Aowlspt.Abi</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
