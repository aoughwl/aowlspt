<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local package sources.

  The user-level NuGet.Config on this machine was narrowed to a single local
  folder feed, which makes every restore outside that feed fail. <clear/> drops
  inherited sources so this repo restores from nuget.org regardless of what the
  machine-level config says.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
