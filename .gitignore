# Build output
bin/
obj/
nimcache/

# nimony leaves its intermediate NIF files beside the sources it compiles
*.nif
!reference/**/*.nif

# Tool output that is regenerated rather than reviewed
reference/*.txt
reference/*.err

# Local editor state
.vs/
.idea/
*.user

# Installer build output and the payload assembled into the tree by `aowl payload`
installer/build/
installer/payload/aowlspt/
installer/payload/runtime/
installer/payload/client/
installer/payload/payload.json

# Compiled test executables left beside the ABI layout tests
tests/*.exe

# The stand-in runtime is built by `aowl test`, not checked in
tests/mockil2cpp/GameAssembly.dll
tests/detour_test.exe

# Test-host artefacts: compiled probes and the screenshots they produce. They
# are evidence in a report, not sources, and a 2 MB bitmap per run is not
# something a history should carry.
*.exe
*.bmp
tests/overlayhost/shots/
tests/overlayhost/shots-*/

# Trees the test hosts assemble for themselves: a staged install, a staged
# backend and the database, logs and selection files they write while running.
# Every one of them is produced by `aowl test`, and `shots-4k` alone is 292 MB.
tests/overlayhost/ovstage/

# `backendstage` is half fixture and half output. The fixtures — a small
# `db.json`, the manager's config, a registry to refresh against — are inputs a
# reviewer needs to read. Everything below is written by the run: logs, the
# selection the manager persists, its store, and the mod library `aowl test`
# builds and copies in. The library in particular was committed once at 616 KB.
tests/overlayhost/backendstage/*.log
tests/overlayhost/backendstage/store/
tests/overlayhost/backendstage/mods/aowlspt-selection.json
tests/overlayhost/backendstage/mods/**/*.dll

# `aowl importdb` output. This is BSG's data by way of SPT's: it is produced
# locally from your own install, never committed and never released.
build/db/

# A selection file is written by the mod manager at run time, and it decides
# what the next start loads. One was committed here: `side: sim`, naming two
# mods -- so a simulator pointed at `mods/` honoured a checked-in artifact and
# loaded two of the ten. It is output, in the source tree, that changes
# behaviour.
#
# The rule alone did nothing: a file already tracked stays tracked, so this sat
# here ignored and committed at the same time, and the ignore read as if it had
# solved something. Untracked with `git rm --cached` on 2026-08-19; it still
# names an absolute path from one machine, which is the other half of why a
# clone must not have it.
mods/aowlspt-selection.json

# The capture's bulk data tables. `mods/tarkov/data/capture/raid1/responses`
# holds the real backend's answers, decoded; the small ones are contracts and
# are reviewed, but fifteen of them are BSG's own data tables -- 18 MB of
# `/client/items`, 13 MB of `/client/dialogue` -- and those are regenerated
# from the .saz rather than stored. `tools/bsgwire.py extract` rebuilds them.
mods/tarkov/data/capture/raid1/responses/large/

# Python bytecode from tools/*.py
__pycache__/

# Texture mod: the assembled image pack (rebuilt by pipeline/build_pack.py --copy)
mods/textures/data/pack/

# Decrypted IL2CPP metadata cache (large, derived, never committed). Also
# `.cache/dlss/`: NVIDIA nvngx_dlss.dll builds, their backups and the state
# file written by tools/dlss.py -- NVIDIA binaries are never committed.
.cache/

# The UI path cache is a LEARNED artifact, stamped with the game build it
# was measured against. Committing it would ship one machine's pointers as
# if they were facts about everyone's install.
tools/uimap.txt

# Runtime relay log written by the aowlcode message bus. It got TRACKED by a
# feature branch and blocked a merge; it is machine-local state, never source.
.aowl-relay.jsonl

# generated by tools/gen_test_settings_ack.py; regenerate, never commit
tools/test_settings_ack.gen.h
tools/test_settings_ack.exe
# generated by tools/gen_test_settings_display.py; regenerate, never commit
tools/test_settings_display.gen.h
tools/test_settings_display.exe

# per-checkout build lock (tools/buildlock.py); never shared
.aowl-build.lock
.aowl-build.queue/
# the hang detector's CPU-sample baseline; regenerated, machine-local
.aowl-build.hung.json
# agent worktrees: measured 58MB listing, never commit
.claude/worktrees/
# a SQLite backup of the fact store; it carried the private address into the tree once
docs/aowl-facts.db.backup
*.db.backup

# tools/selftests.py caches its last verdict here so a deploy gate can reuse
# a green run instead of re-running the suite. Machine state, not a source.
.aowl-selftests.json

# Staged builds. tools/buildlock.py copies every artifact it proves into
# .stage/<target>/<sha12>/ so that a LATER build (aowl removes its output
# before writing it) cannot delete the bytes a deploy is about to copy --
# measured 2026-09-04. Derived, per-checkout, never committed.
.stage/

# aowl.basement: the selfcheck writes TTS wavs and the brain line cache here
mods/basement/data/cache/

# voice benchmark samples are regenerable and large; notes stay tracked
mods/basement/data/samples/*.wav
