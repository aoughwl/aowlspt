<?xml version="1.0" encoding="utf-8"?>
<!-- BepInEx.Core / BepInEx.Analyzers / BepInEx.PluginInfoProps live on the
     BepInEx feed, not nuget.org (MEASURED 2026-09-06: restore from nuget.org
     alone fails with NU1101). Same two sources as SPT-FOV-Fix\NuGet.Config. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
