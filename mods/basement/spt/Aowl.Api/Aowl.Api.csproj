<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aowl API (aowl.api): the SPT 4.1.5 client library for the aowlspt
       backend: sidecar discovery, the event stream, speech in/out, the brain
       and the world queries, as a BepInEx plugin other plugins depend on
       with [BepInDependency("aowl.api")]. Same shape as Basement.Client.csproj
       (netstandard2.1, BepInEx.Core 5.*, references from D:\SPT415).
         dotnet build -c Release -p:OutDir=<dir>\     -> <dir>\Aowl.Api.dll + Aowl.Api.xml
       Never build without OutDir unless you mean to write into D:\SPT415. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Aowl.Api</AssemblyName>
    <RootNamespace>Aowl.Api</RootNamespace>
    <Description>Aowl API -- SPT 4.1.5 client library for the aowlspt backend (speech, brain, events, world)</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SptInstallDir Condition="'$(SptInstallDir)' == '' and '$(SPT_INSTALL_DIR)' != ''">$(SPT_INSTALL_DIR)</SptInstallDir>
    <SptInstallDir Condition="'$(SptInstallDir)' == ''">D:\SPT415</SptInstallDir>
    <GameManagedDir>$(SptInstallDir)\EscapeFromTarkov_Data\Managed</GameManagedDir>
    <OutDir Condition="'$(OutDir)' == ''">$(SptInstallDir)\BepInEx\plugins\</OutDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (public member without an XML comment) is suppressed ONLY because
         BepInEx.PluginInfoProps generates a public PluginInfo class with none.
         Audited 2026-09-07 with the warning ON: every member of this API had
         a doc; the four CS1591s were all PluginInfo. Re-audit by removing it. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Target Name="Build Cleanup" AfterTargets="Build">
    <Delete Files="$(OutDir)$(AssemblyName).pdb" />
    <Delete Files="$(OutDir)$(AssemblyName).deps.json" />
  </Target>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
  </ItemGroup>
</Project>
