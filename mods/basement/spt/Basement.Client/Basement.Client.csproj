<Project Sdk="Microsoft.NET.Sdk">

  <!-- Escape From My Basement, SPT 4.1.5 client plugin (aowl.basement).
       Shape copied from C:\Users\savant\Projects\SPT-FOV-Fix\FOVFix.csproj
       (MEASURED 2026-09-06: netstandard2.1, BepInEx.Core 5.*, references
       from D:\SPT415). Build with
         dotnet build -c Release                      -> D:\SPT415\BepInEx\plugins\Basement.Client.dll
         dotnet build -c Release -p:OutDir=<dir>\     -> anywhere else (never touches D:\SPT415)
       Override the install with SPT_INSTALL_DIR or -p:SptInstallDir=. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Basement.Client</AssemblyName>
    <RootNamespace>Basement.Client</RootNamespace>
    <Description>Escape From My Basement -- SPT 4.1.5 client for the aowl.basement backend</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SptInstallDir Condition="'$(SptInstallDir)' == '' and '$(SPT_INSTALL_DIR)' != ''">$(SPT_INSTALL_DIR)</SptInstallDir>
    <SptInstallDir Condition="'$(SptInstallDir)' == ''">D:\SPT415</SptInstallDir>
    <GameManagedDir>$(SptInstallDir)\EscapeFromTarkov_Data\Managed</GameManagedDir>
    <BepInExCoreDir>$(SptInstallDir)\BepInEx\core</BepInExCoreDir>
    <SptPluginDir>$(SptInstallDir)\BepInEx\plugins\spt</SptPluginDir>
    <OutDir Condition="'$(OutDir)' == ''">$(SptInstallDir)\BepInEx\plugins\</OutDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyProjectReferencesToOutputDirectory>false</CopyProjectReferencesToOutputDirectory>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="Build Cleanup" AfterTargets="Build">
    <Delete Files="$(OutDir)$(AssemblyName).pdb" />
    <Delete Files="$(OutDir)$(AssemblyName).deps.json" />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(GameManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
  </ItemGroup>
</Project>
