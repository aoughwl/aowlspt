{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "8000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-compile-in-gitbash.py\"",
            "timeout": 10,
            "statusMessage": "Checking for a compiler under Git Bash..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-context-bombs.py\"",
            "timeout": 10,
            "statusMessage": "Checking for a context bomb..."
          }
        ]
      }
    ]
  }
}
